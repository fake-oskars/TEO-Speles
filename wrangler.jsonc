// Cloudflare Workers static-assets deployment: `npm run deploy`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teospeles",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.teospeles.lv", "custom_domain": true },
    { "pattern": "teospeles.lv", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths serve index.html
    "not_found_handling": "single-page-application"
  }
}
